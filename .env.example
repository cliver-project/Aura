# Aura local configuration.
#
# Copy to .env (scripts/bootstrap.sh does this for you) and never commit .env.
# Values generated by the bootstrap script: AURA_POSTGRES_PASSWORD,
# AURA_GITEA_PASSWORD, AURA_GITEA_TOKEN, AURA_RUNNER_TOKEN.

# --- PostgreSQL -------------------------------------------------------------
AURA_POSTGRES_PASSWORD=change-me

# --- Gitea ------------------------------------------------------------------
AURA_GITEA_URL=http://localhost:3000
AURA_GITEA_USER=aura
AURA_GITEA_PASSWORD=change-me
# Generated by `gitea admin user generate-access-token`.
AURA_GITEA_TOKEN=
AURA_GITEA_OWNER=aura
# Initial UI language for the configured Gitea user (en-US, zh-CN, zh-TW).
# Also used as Gitea's instance default. Editable later in Aura Settings.
AURA_GITEA_LANGUAGE=en-US

# --- Backend ----------------------------------------------------------------
AURA_DATABASE_URL=postgresql+asyncpg://aura:change-me@127.0.0.1:5433/aura
AURA_WORKSPACE_DIR=./var/workspaces
AURA_LOG_DIR=./var/logs

# --- Claude Code agents -----------------------------------------------------
# Empty means "inherit the shell environment / Claude Code default".
AURA_DEFAULT_MODEL=
AURA_PERMISSION_MODE=bypassPermissions
AURA_MAX_BUDGET_USD=10
AURA_MAX_CONCURRENT_RUNS=3
AURA_AGENT_TIMEOUT_SECONDS=3600
AURA_PUBLIC_URL=http://127.0.0.1:5173

# --- Knowledge base (RAGFlow v1.0.0-rc2) -----------------------------------
AURA_RAGFLOW_URL=http://127.0.0.1:9380
AURA_RAGFLOW_API_KEY=
# Single tenant account Aura registers and uses to mint its API key.
# Leave the email empty to use the local Git user.email during onboarding.
# Leave the password empty to reuse AURA_GITEA_PASSWORD.
AURA_RAGFLOW_ACCOUNT_EMAIL=
AURA_RAGFLOW_ACCOUNT_PASSWORD=
# Initial RAGFlow UI language for the tenant account (en, zh-Hans, zh-Hant).
AURA_RAGFLOW_LANGUAGE=en
# Standalone MCP server published by the RAGFlow compose stack.
AURA_RAGFLOW_MCP_URL=http://127.0.0.1:9382/sse
AURA_RAGFLOW_WEB_URL=http://127.0.0.1:8080

# --- Claude Code model provider (optional) ---------------------------------
# Values can also be set in Settings or overridden per agent.
# AURA_ANTHROPIC_BASE_URL=
# AURA_ANTHROPIC_AUTH_TOKEN=
# AURA_ANTHROPIC_MODEL=
# AURA_ANTHROPIC_DEFAULT_OPUS_MODEL=
# AURA_ANTHROPIC_DEFAULT_SONNET_MODEL=
# AURA_ANTHROPIC_DEFAULT_HAIKU_MODEL=
# AURA_CLAUDE_CODE_SUBAGENT_MODEL=
# AURA_CLAUDE_CODE_EFFORT_LEVEL=
# AURA_CLAUDE_CODE_AUTO_COMPACT_WINDOW=
# AURA_CLAUDE_CODE_DISABLE_UNKNOWN_MODEL_WINDOW_ENFORCEMENT=

# --- UI defaults ------------------------------------------------------------
AURA_DEFAULT_LOCALE=en
AURA_DEFAULT_THEME=system
AURA_AUTO_PIPELINE=true

# --- Gitea Actions (optional profile `actions`) -----------------------------
AURA_RUNNER_TOKEN=
